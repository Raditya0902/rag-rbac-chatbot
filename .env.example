# LLM — get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Gemini — used for RAGAS evaluation (free tier: 1M TPM). Get key at https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# LangSmith tracing (optional — set to "true" to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-rbac-chatbot

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_strong_secret_key_here
JWT_EXPIRE_MINUTES=60

# Llama Guard 3 second-stage safety check (set to true to enable; adds ~200ms latency)
ENABLE_GUARD_MODEL=false
GUARD_MODEL=meta-llama/llama-guard-3-8b

# Redis — used for session memory and JWT denylist
REDIS_URL=redis://redis:6379
